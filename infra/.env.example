# Shared overrides for host-level infra scripts.
API_ENV_FILE=/etc/electroria/api.env
WEB_ENV_FILE=/etc/electroria/web.env
BACKUP_DIR=/var/backups/electroria
CERTBOT_WEBROOT=/var/www/letsencrypt
CF_ZONE_NAME=electroria.com
CF_WWW_HOST=www.electroria.com
CF_ORIGIN_IPV4=109.123.248.164
CF_SSL_MODE=strict
CF_PURGE_CACHE=true
