[Unit]
Description=Electroria Web SSR
After=network.target electroria-api.service
Wants=electroria-api.service

[Service]
Type=simple
User=electroria
Group=electroria
WorkingDirectory=/var/www/electroria/apps/web
EnvironmentFile=/etc/electroria/web.env
ExecStart=/var/www/bin/run-release-entry.sh /var/www/electroria/apps/web/releases/current/server/server.mjs
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
