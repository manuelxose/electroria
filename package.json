{
  "name": "electroria-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Electroria monorepo: Angular SSR web corporativa + API editorial/contacto + tipos compartidos",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:deps:up": "docker compose --project-name electroria-dev -f infra/docker-compose.dev.yml up -d",
    "dev:deps:down": "docker compose --project-name electroria-dev -f infra/docker-compose.dev.yml down",
    "dev:web": "npm run -w apps/web start",
    "build:types": "npm run -w packages/shared-types build",
    "build:web": "npm run -w apps/web build",
    "build:ssr:web": "npm run -w apps/web build:ssr",
    "serve:ssr:web": "npm run -w apps/web serve:ssr",
    "dev:api": "npm run -w apps/api dev",
    "build:api": "npm run -w apps/api build",
    "start:api": "npm run -w apps/api start",
    "migrate:api": "npm run -w apps/api migrate",
    "seed:blog": "npm run -w apps/api seed:blog",
    "build": "npm run build:types && npm run build:web && npm run build:api"
  }
}
