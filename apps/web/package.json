{
  "name": "electroria-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Electroria Angular 20 + SSR",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run clean && ng build --configuration production",
    "build:watch": "ng build --configuration production --watch",
    "build:ssr": "npm run clean && ng build --configuration production",
    "build:ssr:initial": "npm run clean && ng build --configuration production",
    "build:server:watch": "ng build --configuration production --watch",
    "serve:ssr": "node dist/server/server.mjs",
    "serve:ssr:watch": "nodemon --watch dist/server --delay 2000ms --exec \"node dist/server/server.mjs\"",
    "dev:ssr": "npm run build:ssr && npm run serve:ssr",
    "dev:ssr:clean": "npm run clean && npm run dev:ssr",
    "serve-ssr:dev": "npm run serve:ssr",
    "clean": "rimraf dist .angular node_modules/.cache",
    "lint": "eslint . --ext .ts,.html",
    "test": "echo \"(tests not configured)\" && exit 0",
    "e2e": "echo \"E2E not configured (use Cypress/Playwright)\" && exit 0"
  },
  "dependencies": {
    "@angular/animations": "^20.3.10",
    "@angular/common": "^20.3.10",
    "@angular/compiler": "^20.3.10",
    "@angular/core": "^20.3.10",
    "@angular/forms": "^20.3.10",
    "@angular/localize": "^20.3.10",
    "@angular/platform-browser": "^20.3.10",
    "@angular/platform-browser-dynamic": "^20.3.10",
    "@angular/platform-server": "^20.3.10",
    "@angular/router": "^20.3.10",
    "@angular/ssr": "^20.3.9",
    "express": "^4.21.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.15.0"
  },
  "optionalDependencies": {
    "domino": "^2.1.6"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.9",
    "@angular/cli": "^20.3.9",
    "@angular/compiler-cli": "^20.3.10",
    "@esbuild/linux-x64": "^0.27.3",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.10",
    "eslint": "^8.57.0",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.1",
    "karma-chrome-launcher": "~3.1.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.0.0",
    "nodemon": "^3.0.1",
    "rimraf": "^5.0.5",
    "typescript": "~5.8.0"
  },
  "license": "ISC",
  "author": ""
}
